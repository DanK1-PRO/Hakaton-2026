{
  "name": "DDS-2026",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "privileged": true,
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [8000, 8080, 5173],
  "portsAttributes": {
    "8080": { "label": "UI (Docker Compose)", "onAutoForward": "notify" },
    "8000": { "label": "API /docs", "onAutoForward": "silent" },
    "5173": { "label": "UI (native dev)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "python -m pip install -r backend/requirements.txt && npm ci --prefix frontend",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
